+void KisImage::setCoopDirtyTracking(bool enabled)
+{
+    QMutexLocker l(&m_d->coopDirtyMutex);
+    m_d->coopDirtyTracking.storeRelease(enabled ? 1 : 0);
+    m_d->coopDirtyRects.clear();
+}
