+}
+
+QVector<QPair<QUuid, QRect>> KisImage::takeCoopDirtyRects()
+{
+    QHash<QUuid, QVector<QRect>> log;
+    {
+        QMutexLocker l(&m_d->coopDirtyMutex);
+        log.swap(m_d->coopDirtyRects);
+    }
+
+    QVector<QPair<QUuid, QRect>> result;
+    for (auto it = log.constBegin(); it != log.constEnd(); ++it) {
+        Q_FOREACH (const QRect &rc, it.value()) {
+            result.append(qMakePair(it.key(), rc));
+        }
+    }
+    return result;
+}
+
+void KisImage::setCoopDirtySuppressedForCurrentThread(bool suppressed)
+{
+    m_d->coopDirtySuppressedThread.storeRelease(suppressed ? QThread::currentThread() : nullptr);
+}
