+QByteArray Node::coopPixelData(int x, int y, int w, int h) const
+{
+    QByteArray ba;
+
+    if (!d->node || w <= 0 || h <= 0) return ba;
+
+    KisPaintDeviceSP dev = d->node->paintDevice();
+    if (!dev) return ba;
+
+    const QRect rc(x, y, w, h);
+    KisIndirectPaintingSupport *indirect =
+        dynamic_cast<KisIndirectPaintingSupport*>(d->node.data());
+
+    if (indirect) {
+        // the final merge of a stroke keeps this lock over several jobs: never wait for it
+        if (!indirect->tryLockTemporaryTargetForRead()) return ba;
+
+        KisPaintDeviceSP overlay = indirect->temporaryTarget();
+        if (overlay && overlay != dev) {
+            // the same as KisPaintLayer::copyOriginalToProjection()
+            KisPaintDeviceSP scratch = new KisPaintDevice(dev->colorSpace());
+            scratch->setDefaultPixel(dev->defaultPixel());
+            KisPainter::copyAreaOptimized(rc.topLeft(), dev, scratch, rc);
+            {
+                KisPainter gc(scratch);
+                indirect->setupTemporaryPainter(&gc);
+                gc.bitBlt(rc.topLeft(), overlay, rc);
+            }
+            indirect->unlockTemporaryTargetAfterRead();
+
+            ba.resize(w * h * scratch->pixelSize());
+            scratch->readBytes(reinterpret_cast<quint8*>(ba.data()), x, y, w, h);
+            return ba;
+        }
+        indirect->unlockTemporaryTargetAfterRead();
+    }
+
+    ba.resize(w * h * dev->pixelSize());
+    dev->readBytes(reinterpret_cast<quint8*>(ba.data()), x, y, w, h);
+    return ba;
+}
+
+bool Node::coopOverlayActive() const
+{
+    if (!d->node) return false;
+
+    KisIndirectPaintingSupport *indirect =
+        dynamic_cast<KisIndirectPaintingSupport*>(d->node.data());
+
+    return indirect && indirect->hasTemporaryTarget();
+}
+
+bool Node::coopSetPixelData(QByteArray value, int x, int y, int w, int h)
+{
+    if (!d->node || w <= 0 || h <= 0) return false;
+
+    KisPaintDeviceSP dev = d->node->paintDevice();
+    if (!dev) return false;
+
+    if (value.length() < w * h * (int)dev->colorSpace()->pixelSize()) {
+        qWarning() << "Node::coopSetPixelData: not enough data to write to the paint device";
+        return false;
+    }
+
+    dev->writeBytes((const quint8*)value.constData(), x, y, w, h);
+
+    // invalidates the device's caches and asks the image for an asynchronous update
+    // of this rect only; the co-op dirty log must not see our own write
+    KisImageSP image = d->image.toStrongRef();
+    if (image) image->setCoopDirtySuppressedForCurrentThread(true);
+    dev->setDirty(QRect(x, y, w, h));
+    if (image) image->setCoopDirtySuppressedForCurrentThread(false);
+
+    return true;
+}
