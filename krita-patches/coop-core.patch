+void KisImage::pauseProcessingForCoop()
+{
+    if (!locked()) {
+        /**
+         * No requestStrokeEnd() here: the tools must keep their strokes open.
+         *
+         * And no notifyWaitOnImageStarted() either: its feedback callback waits (with a
+         * dialog) until the image is idle, i.e. until the whole stroke has ended. We only
+         * wait for the jobs that are running right now, so the "general wait" flag is the
+         * right one: it just tells the worker threads not to block on the GUI thread.
+         */
+        KisBusyWaitBroker::instance()->notifyGeneralWaitStarted();
+        m_d->scheduler.immediateLockForReadOnly();
+        KisBusyWaitBroker::instance()->notifyGeneralWaitEnded();
+        m_d->lockedForReadOnly = true;
+    }
+    m_d->lockCount++;
+}
