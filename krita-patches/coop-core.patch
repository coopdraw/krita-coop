+
+QByteArray Document::coopTakeDirty()
+{
+    QByteArray ba;
+    if (!d->document || !d->document->image()) return ba;
+
+    const QVector<QPair<QUuid, QRect>> log = d->document->image()->takeCoopDirtyRects();
+    ba.reserve(log.size() * 32);
+
+    Q_FOREACH (const auto &item, log) {
+        ba.append(item.first.toRfc4122());
+        const qint32 v[4] = {item.second.x(), item.second.y(), item.second.width(), item.second.height()};
+        for (int k = 0; k < 4; k++) {
+            const quint32 u = quint32(v[k]);
+            const char bytes[4] = {char(u & 0xff), char((u >> 8) & 0xff), char((u >> 16) & 0xff), char((u >> 24) & 0xff)};
+            ba.append(bytes, 4);
+        }
+    }
+    return ba;
+}
